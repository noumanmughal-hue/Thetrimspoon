ANTHROPIC_API_KEY=
PORT=3000

# Credentials for the staff dashboard (/staff.html, /api/orders) — required.
# Without these set, the staff dashboard is unreachable rather than left open.
STAFF_USERNAME=
STAFF_PASSWORD=

# Postgres connection string for order storage (Neon, via the Vercel Marketplace
# integration — copy the pooled "DATABASE_URL" it gives you). Without this set,
# the app still runs, but placing/viewing orders fails with a clear error instead
# of a crash.
DATABASE_URL=
